' Historical illustration, normalized for publication. Superseded, not a maintained template.
@startuml
' DS-01 — CU-01 Quote cart, all specified local flows
' Author: design author (AI). See operation-delta.md for allocation.
title DS-01 · CU-01 Quote cart\nTrusted catalog, explicit refusals, integer cents
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontSize 13
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 75
hide footbox
actor Shopper as ACT_Shopper
boundary QuoteRequestPort as B_Port
control QuoteService as C_Quote
entity Cart as E_Cart
participant ProductCatalog as INF_Products
participant CouponCatalog as INF_Coupons
participant PolicyResolver as INF_Resolver
entity Coupon as E_Coupon
participant DiscountPolicy as INF_Policy

== Request boundary and Cart validation — CU-01 steps 1–2 ==
ACT_Shopper -> B_Port : handle(request) <<synchCall>>
break FE-01 invalid currency, time, shape or multiple Coupon codes
  B_Port --> ACT_Shopper : failure(reasonCategory), no quote <<reply>>
end
note right of B_Port
  Decode Product codes and quantities only.
  Caller prices never become authoritative.
  UTC time is explicit; no hidden clock.
end note
B_Port -> C_Quote : quote(cart, currency, couponCode, evaluatedAt) <<synchCall>>
C_Quote -> E_Cart : validate() <<synchCall>>
break FE-01 empty Cart or quantity not an integer 1..99 (Boolean excluded)
  E_Cart --> C_Quote : Refusal(EMPTY_CART or INVALID_QUANTITY) <<reply>>
  C_Quote --> B_Port : Refusal(reasonCategory) <<reply>>
  B_Port --> ACT_Shopper : failure(reasonCategory), no quote <<reply>>
end
E_Cart --> C_Quote : validated Cart <<reply>>

== Trusted Product resolution and total — CU-01 steps 3–4 ==
loop each CartLine, preserving repeated Product identities
  C_Quote -> INF_Products : lookup_product(productCode) <<synchCall>>
  INF_Products --> C_Quote : Product or absent <<reply>>
  break FE-02 Product absent from trusted catalog
    C_Quote --> B_Port : Refusal(UNKNOWN_PRODUCT) <<reply>>
    B_Port --> ACT_Shopper : failure(UNKNOWN_PRODUCT), no quote <<reply>>
  end
end
C_Quote -> E_Cart : subtotal(resolvedProducts, currency) <<synchCall>>
break FE-03 trusted Product cents invalid or currency unsupported
  E_Cart --> C_Quote : Refusal(INVALID_PRODUCT_CONFIGURATION) <<reply>>
  C_Quote --> B_Port : Refusal(INVALID_PRODUCT_CONFIGURATION) <<reply>>
  B_Port --> ACT_Shopper : failure(INVALID_PRODUCT_CONFIGURATION), no quote <<reply>>
end
alt FA-03 valid nonempty Cart with only zero-priced Products
  E_Cart --> C_Quote : subtotal = 0; still check Coupon conditions <<reply>>
else ordinary valid Cart
  E_Cart --> C_Quote : subtotal = sum(unitPrice * quantity) <<reply>>
end

== Coupon configuration and eligibility — CU-01 step 5 ==
opt Coupon code supplied
  C_Quote -> INF_Coupons : lookup_coupon(couponCode) <<synchCall>>
  break FE-07 invalid Coupon expiry representation in trusted setup
    INF_Coupons --> C_Quote : Refusal(INVALID_COUPON_CONFIGURATION) <<reply>>
    C_Quote --> B_Port : Refusal(INVALID_COUPON_CONFIGURATION) <<reply>>
    B_Port --> ACT_Shopper : failure(INVALID_COUPON_CONFIGURATION), no quote <<reply>>
  end
  INF_Coupons --> C_Quote : Coupon or absent <<reply>>
  break FE-04 supplied Coupon absent from catalog
    C_Quote --> B_Port : Refusal(UNKNOWN_COUPON) <<reply>>
    B_Port --> ACT_Shopper : failure(UNKNOWN_COUPON), no full-price fallback <<reply>>
  end
end
C_Quote -> INF_Resolver : resolve(coupon or None) <<synchCall>>
break FE-07 unregistered kind or invalid fixed/rate configuration
  INF_Resolver --> C_Quote : Refusal(INVALID_COUPON_CONFIGURATION) <<reply>>
  C_Quote --> B_Port : Refusal(INVALID_COUPON_CONFIGURATION) <<reply>>
  B_Port --> ACT_Shopper : failure(INVALID_COUPON_CONFIGURATION), no quote <<reply>>
end
INF_Resolver --> C_Quote : configured DiscountPolicy (NoDiscount when absent) <<reply>>
opt Coupon supplied and resolved
  C_Quote -> E_Coupon : check_eligibility(subtotal, evaluatedAt, currency) <<synchCall>>
  break FE-07 noninteger minimum, invalid expiry or unsupported Coupon currency
    E_Coupon --> C_Quote : Refusal(INVALID_COUPON_CONFIGURATION) <<reply>>
    C_Quote --> B_Port : Refusal(INVALID_COUPON_CONFIGURATION) <<reply>>
    B_Port --> ACT_Shopper : failure(INVALID_COUPON_CONFIGURATION), no quote <<reply>>
  end
  break FE-05 evaluatedAt >= expiresAt
    E_Coupon --> C_Quote : Refusal(EXPIRED_COUPON) <<reply>>
    C_Quote --> B_Port : Refusal(EXPIRED_COUPON) <<reply>>
    B_Port --> ACT_Shopper : failure(EXPIRED_COUPON), no quote <<reply>>
  end
  break FE-06 subtotal < minimumSubtotal
    E_Coupon --> C_Quote : Refusal(COUPON_MINIMUM_NOT_REACHED) <<reply>>
    C_Quote --> B_Port : Refusal(COUPON_MINIMUM_NOT_REACHED) <<reply>>
    B_Port --> ACT_Shopper : failure(COUPON_MINIMUM_NOT_REACHED), no quote <<reply>>
  end
  E_Coupon --> C_Quote : eligible Coupon, unchanged state <<reply>>
end

== Pure calculation and completion — CU-01 steps 5–7 ==
C_Quote -> INF_Policy : discount(subtotal, currency) <<synchCall>>
alt Basic no Coupon — policy is NoDiscount
  INF_Policy --> C_Quote : discount = 0 <<reply>>
else FA-01 eligible fixed Coupon — policy is FixedDiscount
  INF_Policy --> C_Quote : discount = min(configuredAmount, subtotal) <<reply>>
else FA-02 eligible percentage Coupon — policy is PercentageDiscount
  INF_Policy --> C_Quote : discount = subtotal * basisPoints // 10000 <<reply>>
end
note right of INF_Policy
  Calculation contract: nonnegative integer CNY subtotal.
  Result: integer 0..subtotal; deterministic; no mutation.
  A zero subtotal yields zero under every supported policy.
  Configuration/eligibility were checked before calculation.
end note
create entity PriceQuote as E_Result
C_Quote -> E_Result : PriceQuote(subtotal, discount, subtotal-discount, currency) <<createMessage>>
note right of E_Result
  Constructor enforces the common quote invariants.
  This lifecycle message is not an ordinary PriceQuote operation.
end note
C_Quote --> B_Port : successful PriceQuote <<reply>>
B_Port --> ACT_Shopper : success(subtotal, discount, payable, CNY) <<reply>>

legend bottom
All calls are synchronous; dashed arrows are replies to their original caller.
Each break terminates the enclosing quote interaction. A refusal never reaches creation.
No order, payment, redemption, persistence or mutation operation exists in this collaboration.
Negative-minimum acceptance/refusal remains outside the bounded baseline; no new rule is inferred.
endlegend
@enduml

@startuml
/' English-edition adaptation: Copyright 2026 kingle.zhuang. See NOTICE for upstream attribution. '/
left to right direction
skinparam linetype ortho
skinparam shadowing false

actor "Customer" as ACT_Customer
boundary "Reservation Page" as B_PaginaReservation
boundary "Confirmation Page" as B_PaginaConfirmacion
control "Check availability" as C_VerificarDisponibilidad
control "Record reservation" as C_RegistrarReservation
entity "Room" as E_Room
entity "Reservation" as E_Reservation

ACT_Customer -- B_PaginaReservation
B_PaginaReservation -- C_VerificarDisponibilidad : request availability
C_VerificarDisponibilidad -- E_Room
C_VerificarDisponibilidad -- C_RegistrarReservation
C_RegistrarReservation -- E_Reservation
C_RegistrarReservation -- B_PaginaConfirmacion
@enduml

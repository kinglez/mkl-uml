left to right direction
skinparam linetype ortho
skinparam shadowing false

actor "Customer" as ACT_Customer
boundary "Reservation Page" as B_PaginaReservation
boundary "Confirmation Page" as B_PaginaConfirmacion
control "Record reservation" as C_RegistrarReservation
entity "Reservation" as E_Reservation
entity "Room" as E_Room

ACT_Customer -- B_PaginaReservation
B_PaginaReservation -- B_PaginaConfirmacion : show
B_PaginaReservation -- E_Reservation
E_Reservation -- E_Room
C_RegistrarReservation -- E_Reservation
@enduml

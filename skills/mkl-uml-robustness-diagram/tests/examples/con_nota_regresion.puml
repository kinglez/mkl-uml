@startuml
/' English-edition adaptation: Copyright 2026 kingle.zhuang. See NOTICE for upstream attribution. '/
left to right direction
skinparam linetype ortho
skinparam shadowing false

actor "Customer" as ACT_Customer
boundary "Registration Form" as B_Formulario
control "Validate category status" as C_ValidarCategory
control "Record request" as C_Registrar
entity "Support Request" as E_Request
entity "Category" as E_Category

ACT_Customer -- B_Formulario
B_Formulario -- C_ValidarCategory : FA-01 inactive category
B_Formulario -- C_ValidarCategory : FE-01 attachment too large
C_ValidarCategory -- E_Category
C_ValidarCategory -- C_Registrar
C_Registrar -- E_Request

note as TextoCU
CU-03 Record support request
--
BASIC COURSE: The Customer opens the screen. The Customer
selects a Category. The system records the request.
--
ALTERNATIVE COURSES:
FA-01: If the Category is inactive, request another.
FE-01: If the Attachment exceeds the size limit, reject it.
end note
@enduml

' DS-01 - Sequence for CU-01 Register vehicle entry
skinparam style strictuml
skinparam shadowing false
skinparam responseMessageBelowArrow true

actor "Operator" as ACT_Operator
boundary "Entry Console" as B_Console
boundary "Entry Receipt" as B_Receipt
entity "Vehicle" as E_Vehicle
entity "ParkingSpace" as E_ParkingSpace
entity "Ticket" as E_Ticket

== Identification ==

ACT_Operator -> B_Console : register vehicle entry
B_Console -> E_Vehicle : identify by license plate
E_Vehicle -> E_Vehicle : check no open entry ticket

alt FA-02 vehicle already has an open entry ticket
  E_Vehicle --> B_Console : existing open ticket
  B_Console -> ACT_Operator : display existing entry ticket; entry rejected
else vehicle may enter
  E_Vehicle -> E_ParkingSpace : request available parking space

  == Allocation ==

  alt FA-01 no parking space available
    E_ParkingSpace --> E_Vehicle : unavailable
    E_Vehicle --> B_Console : unavailable
    B_Console -> ACT_Operator : display message 'Parking lot full'; return to entry console
  else basic course
    E_ParkingSpace -> E_ParkingSpace : occupy with vehicle
    E_ParkingSpace -> E_Ticket : issue entry ticket
    E_Ticket --> E_ParkingSpace : ticket issued
    E_ParkingSpace --> E_Vehicle : assigned parking space and ticket
    E_Vehicle --> B_Console : vehicle entry ticket
    B_Console -> B_Receipt : present receipt
    B_Receipt -> ACT_Operator : display entry receipt with ticket and parking space
  end
end
@enduml

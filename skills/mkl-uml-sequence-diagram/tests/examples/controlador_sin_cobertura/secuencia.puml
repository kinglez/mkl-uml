' DS-01 - Sequence for CU-01 Register vehicle entry
skinparam style strictuml
skinparam shadowing false
skinparam responseMessageBelowArrow true

actor "Operator" as ACT_Operator
boundary "Entry Console" as B_Console
boundary "Entry Receipt" as B_Receipt
entity "Vehicle" as E_Vehicle
entity "ParkingSpace" as E_ParkingSpace

== Identification ==

ACT_Operator -> B_Console : register vehicle entry
B_Console -> E_Vehicle : identify by license plate
E_Vehicle -> E_ParkingSpace : request available parking space

== Allocation ==

alt FA-01 no parking space available
  E_ParkingSpace --> E_Vehicle : unavailable
  B_Console -> B_Console : display message 'Parking lot full'
else basic course
  E_ParkingSpace -> E_ParkingSpace : occupy with vehicle
  E_ParkingSpace --> E_Vehicle : parking space occupied
  B_Console -> B_Receipt : present receipt
end
@enduml

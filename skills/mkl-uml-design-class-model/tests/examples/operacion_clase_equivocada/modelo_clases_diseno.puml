@startuml
/' English-edition adaptation: Copyright 2026 kingle.zhuang. See NOTICE for upstream attribution. '/
' MC-04 - Identical to the good set except ONE defect: Member also declares
' calculateDueDate(), addressed to LoanPolicy rather than Member in the sequence.
' This is the method's own example of a Queue that only adds.
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false

class Member {
  -name : String
  -identityDocument : String
  +checkActivePenalty() : Boolean
  +calculateDueDate(e : Copy) : Date
}

class Work {
  -title : String
  -author : String
  +basePeriod() : Integer
}

class Copy {
  -callNumber : String
  -status : String
  +checkAvailability() : Boolean
  +markLoaned() : void
  +basePeriod() : Integer
}

abstract class Loan {
  -startDate : Date
  -dueDate : Date
  +register(member : Member, copy : Copy, dueDate : Date) : Loan
  +generateReceipt() : String
}

class BookLoan {
  +generateReceipt() : String
}

class AudiovisualLoan {
  +generateReceipt() : String
}

class Penalty {
  -reason : String
  -endDate : Date
  +checkActiveStatus() : Boolean
}

class LoanPolicy <<solution>> {
  +calculateDueDate(copy : Copy) : Date
}

Member "1" -- "0..*" Loan
Loan "1" -- "1" Copy
Copy "0..*" -- "1" Work
Member "1" -- "0..*" Penalty
Loan <|-- BookLoan
Loan <|-- AudiovisualLoan
LoanPolicy ..> Copy
@enduml

@startuml
/' English-edition adaptation: Copyright 2026 kingle.zhuang. See NOTICE for upstream attribution. '/
' MC-04 - Design class model for CU-04 Manage loan
'
' FIXTURE: UML derived attribute (`/name`). Standard notation that the
' validator SILENTLY discarded, making classes appear to have
' fewer attributes than declared. All three forms appear here: with visibility,
' without visibility, and protected.
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false

class Member {
  -name : String
  -identityDocument : String
  +checkActivePenalty() : Boolean
}

class Work {
  -title : String
  -author : String
  +basePeriod() : Integer
}

class Copy {
  -callNumber : String
  -status : String
  +checkAvailability() : Boolean
  +markLoaned() : void
  +basePeriod() : Integer
}

abstract class Loan {
  -startDate : Date
  -dueDate : Date
  -/elapsedDays : Integer
  #/loanOverdue : Boolean
  +register(member : Member, copy : Copy, dueDate : Date) : Loan
  +generateReceipt() : String
}

class BookLoan {
  +generateReceipt() : String
}

class AudiovisualLoan {
  +generateReceipt() : String
}

class Penalty {
  -reason : String
  -endDate : Date
  /remainingDays : Integer
  +checkActiveStatus() : Boolean
}

class LoanPolicy <<solution>> {
  +calculateDueDate(copy : Copy) : Date
}

Member "1" -- "0..*" Loan
Loan "1" -- "1" Copy
Copy "0..*" -- "1" Work
Member "1" -- "0..*" Penalty
Loan <|-- BookLoan
Loan <|-- AudiovisualLoan
LoanPolicy ..> Copy
@enduml
